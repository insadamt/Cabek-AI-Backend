# Local AutoEstimate and optional mock camera settings for API/worker processes.
# Depends on a reachable AutoEstimate service and real JPEG/PNG sample files.

AUTOESTIMATE_BASE_URL=http://192.168.2.184:8080/api/v1
AUTOESTIMATE_TOKEN=

CABEK_TUNNEL_MODE=disabled
CABEK_MOCK_PHOTOS_DIR=
CABEK_MOCK_PHOTO_DELAY_SECONDS=0

# Optional local ESP32 bridge; use distinct private credentials of at least 32 characters.
CABEK_LIGHTS_ENABLED=0
CABEK_LIGHTS_PORT=auto
CABEK_LIGHTS_BAUD=115200
CABEK_LIGHTS_TOKEN=
CABEK_LIGHTS_MAINTENANCE_TOKEN=
CABEK_LIGHTS_TIMEOUT=1
CABEK_LIGHTS_RECONNECT_SECONDS=2
CABEK_LIGHTS_HEALTH_SECONDS=5
