# Local AutoEstimate, Tiandy and demo settings for API/worker processes.
# Depends on a reachable AutoEstimate service and real JPEG/PNG sample files.

AUTOESTIMATE_BASE_URL=http://192.168.2.184:8080/api/v1
AUTOESTIMATE_TOKEN=

CABEK_TUNNEL_MODE=disabled
# Tiandy runs separately from RGB (8001 versus the commissioned RGB port 9001).
CABEK_TIANDY_API_URL=http://127.0.0.1:8001
CABEK_TIANDY_API_KEY=
CABEK_MOCK_PHOTOS_DIR=
CABEK_MOCK_PHOTO_DELAY_SECONDS=0

# Optional local ESP32 bridge; use distinct private credentials of at least 32 characters.

# Effect rendering depends on negotiated RGB firmware or explicit memory simulation.
# Publish lifecycle events to the standalone service in cabek-esp32.
CABEK_LIGHTS_ENABLED=0
CABEK_LIGHTS_API_URL=http://127.0.0.1:8001

# Interior white LEDs; explicit false is required to bypass verification.
CABEK_INTERNAL_LIGHTS_ENABLED=true
CABEK_INTERNAL_LIGHTS_URL=http://10.184.56.252
CABEK_INTERNAL_LIGHTS_SWITCH_ID=0
CABEK_INTERNAL_LIGHTS_TIMEOUT=3
CABEK_INTERNAL_LIGHTS_STABILIZATION_MS=500
CABEK_INTERNAL_LIGHTS_MIN_POWER_W=
