# Exclude private configuration, generated data, and local tooling.
# Depends on this repository's runtime and development directory layout.
__pycache__/
*.pyc
.venv/
.env
.streamlit/secrets.toml

.agents/
.codex/
.claude/
.cursor/
.aws/

.pytest_cache/

data/dossiers/**/analysis/


# Private AI workspace and lifecycle coordination files.
.ai/
.instructions.md
.instruction.md
.instrcutions.md
data/dossiers/.lifecycle-locks/
data/dossiers/.delete-*/

# Backend-owned private photographs used by the simulated tunnel.
.local/

# Runtime dossier locks belong to local processes, not saved application data.
data/dossiers/**/.capture.lock
data/dossiers/**/.metadata.lock

# Versioned E-Constat preparation and first-page previews are derived artifacts.
data/dossiers/**/.econstat/

# Dossiers contain installation data and generated inspection documents.
/data/dossiers/

# Local assistant configuration is private to each developer.
.cursor/
AGENTS.md
CLAUDE.md
.github/copilot-instructions.md
.aider*
